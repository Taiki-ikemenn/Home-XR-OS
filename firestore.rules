rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ※ たいアカウントで今使っているルール（たいアカウントセンターや nicehome+ のぶん）は、消さずに「そのまま」残して、この xr_ の部分だけを足してください。

    // Home XR OS：ユーザー
    match /xr_users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
    }
    // Home XR OS：フィード
    match /xr_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Home XR OS：チャット（plaza＝みんなのひろば、dm_A_B＝ふたりのチャット）
    match /xr_rooms/{room} {
      allow read, write: if request.auth != null && (room == 'plaza' || request.auth.uid in room.split('_'));
      match /messages/{msgId} {
        allow read: if request.auth != null && (room == 'plaza' || request.auth.uid in room.split('_'));
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 500
          && (room == 'plaza' || request.auth.uid in room.split('_'));
      }
    }
    // Home XR OS：いっしょの部屋（コードを知っている人だけが入れる）
    match /xr_spaces/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid && code.size() == 6;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['video','env','envAt']);
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Home XR OS：ワールド
    match /xr_worlds/{wid} {
      allow read: if request.auth != null && (resource.data.public == true || resource.data.owner == request.auth.uid);
      allow create, update: if request.auth != null && request.resource.data.owner == request.auth.uid && request.resource.data.data.size() < 1000000;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
